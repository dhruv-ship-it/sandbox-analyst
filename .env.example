# Copy this file to .env and fill in real values. .env is gitignored.

# LLM provider (built in a later task; placeholders for now).
NIM_API_KEY=
GROQ_API_KEY=
SA_LLM_PROVIDER=
SA_LLM_MODEL=

# Sandbox backend: "modal" for the real Modal Sandbox backend, "fake" for
# the in-memory FakeSandbox used by tests and offline development.
SA_SANDBOX=fake

# Lifetime spend cap (USD) enforced by the budget guard before any sandbox
# is created. This is a total across the life of the project, not a
# monthly limit.
SA_SANDBOX_BUDGET_USD=0.80

# Modal authentication is NOT read from this file.
# Locally, Modal auth comes from the Modal CLI profile (`uvx modal token new`).
# In production, it comes from the MODAL_TOKEN_ID / MODAL_TOKEN_SECRET
# environment variables set on the deployment host.
